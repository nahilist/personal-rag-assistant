# ==============================================================================
# Personal RAG Assistant - Environment Configuration
# ==============================================================================

# Public browser configuration (Next.js)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1

# Server-only authentication & database configuration
SUPABASE_URL=http://localhost:54321
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_JWKS_URL=http://localhost:54321/auth/v1/.well-known/jwks.json
SUPABASE_JWT_ISSUER=http://localhost:54321/auth/v1
SUPABASE_JWT_AUDIENCE=authenticated
SUPABASE_JWT_SECRET=your-local-jwt-secret-for-development-at-least-32-chars-long

DATABASE_URL=postgresql://postgres:postgres@localhost:54322/personal_rag
REDIS_URL=redis://localhost:6379/0

# Storage
STORAGE_BUCKET=private-documents
STORAGE_BACKEND=local
STORAGE_LOCAL_DIR=./data/storage

# LLM Provider Configuration
# Options: mock, ollama, openai
LLM_PROVIDER=mock
LLM_BASE_URL=http://localhost:11434/v1
LLM_API_KEY=
LLM_MODEL=llama3.2

# Embedding Configuration
# Options: mock, ollama, openai
EMBEDDING_PROVIDER=mock
EMBEDDING_BASE_URL=http://localhost:11434/v1
EMBEDDING_API_KEY=
EMBEDDING_MODEL=all-minilm
EMBEDDING_REVISION=v1
EMBEDDING_DIMENSION=384

# Service Quotas & Capacities
ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
MAX_ACTIVE_GENERATIONS=20
MAX_UPLOAD_BYTES=20971520
MAX_DOCS_PER_USER=20
MAX_STORAGE_PER_USER=209715200
MAX_PAGES_PER_DOC=200
REQUEST_TIMEOUT_SECONDS=30
